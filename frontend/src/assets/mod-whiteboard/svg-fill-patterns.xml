<svg xmlns="http://www.w3.org/2000/svg" style="width: 0px; height: 0px;">
    
    <!-- Vordefinierte FillPatterns -->
    <defs>

        <pattern id="pattern-vertical" name="vertical" patternUnits="userSpaceOnUse" width="32" height="32" class="fill-pattern" color="black">
            <line x1="0" y1="0" x2="0" y2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line x1="4" y1="0" x2="4" y2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line x1="8" y1="0" x2="8" y2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line x1="12" y1="0" x2="12" y2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line x1="16" y1="0" x2="16" y2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line x1="20" y1="0" x2="20" y2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line x1="24" y1="0" x2="24" y2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line x1="28" y1="0" x2="28" y2="32" fill="none" stroke="currentColor" stroke-width="1" />
        </pattern>

        <pattern id="pattern-horizontal" name="horizontal" patternUnits="userSpaceOnUse" width="32" height="32" class="fill-pattern" color="black">
            <line y1="0" x1="0" y2="0" x2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line y1="4" x1="0" y2="4" x2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line y1="8" x1="0" y2="8" x2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line y1="12" x1="0" y2="12" x2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line y1="16" x1="0" y2="16" x2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line y1="20" x1="0" y2="20" x2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line y1="24" x1="0" y2="24" x2="32" fill="none" stroke="currentColor" stroke-width="1" />
            <line y1="28" x1="0" y2="28" x2="32" fill="none" stroke="currentColor" stroke-width="1" />
        </pattern>

    </defs>    
</svg>
